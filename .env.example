# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Management API token for running SQL against production (see HANDOFF.md §4)
SUPABASE_ACCESS_TOKEN=

# AI
ANTHROPIC_API_KEY=
# Optional: enables AI images for drafts. Leave empty for text-only posts.
OPENAI_API_KEY=
# Optional: defaults to gpt-image-2
OPENAI_IMAGE_MODEL=

# LinkedIn app
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: HMAC key for the OAuth state; falls back to LINKEDIN_CLIENT_SECRET
OAUTH_STATE_SECRET=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Public URL, no trailing slash or newline
NEXT_PUBLIC_APP_URL=http://localhost:3000
